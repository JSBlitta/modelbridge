let 
// Rough sketch: validate the top-level structure and key settings
ValidateConfiguration = (config as record) as record =>
let
    expectedKeys = {
        "connectorSettings",
        "trimbleConnectAuthorization",
        "trimbleConnectURLs",
        "companyConstants",
        "tableColumns",
        "queryParameters"
    },
    // Validate presence of all required keys
    missingKeys = List.Difference(expectedKeys, Record.FieldNames(config)),

    // Validate connectorSettings fields
    connectorSettings = Record.FieldOrDefault(config, "connectorSettings", []),
    requiredConnectorFields = {"companyFolderOnly", "standardFields", "allowedFields", "decimalPlaces", "expandAllFields"},
    missingConnectorFields = List.Difference(requiredConnectorFields, Record.FieldNames(connectorSettings)),

    // Optional: Validate field values
    badFieldTypes = {
        if not Value.Is(connectorSettings[expandAllFields], type logical) then "expandAllFields not boolean" else null,
        if not Value.Is(connectorSettings[standardFields], type list) then "standardFields not list" else null,
        if not Value.Is(connectorSettings[allowedFields], type list) then "allowedFields not list" else null,
        if not Value.Is(connectorSettings[decimalPlaces], type number) then "decimalPlaces not number" else null
    },
    cleanBadFieldTypes = List.RemoveNulls(badFieldTypes),

    // All warnings and errors
    warnings = List.Combine({
        if List.IsEmpty(missingKeys) then {} else {"Missing keys: " & Text.Combine(missingKeys, ", ")},
        if List.IsEmpty(missingConnectorFields) then {} else {"Missing connectorSettings fields: " & Text.Combine(missingConnectorFields, ", ")},
        cleanBadFieldTypes
    }),

    result = if List.IsEmpty(warnings)
        then [IsValid = true, Warnings = {}]
        else [IsValid = false, Warnings = warnings]
in
    result,

ValidateField = (value, expectedType as text, optional requiredSubKeys as list) as list =>
let
    typeOk = Value.Is(value, expectedType),
    errors = if not typeOk then {"Expected type " & Type.Type(expectedType) & ", got " & Value.Type(value)} else {},
    subErrors = if typeOk and expectedType = type record and requiredSubKeys <> null then
        List.Transform(List.Difference(requiredSubKeys, Record.FieldNames(value)), each "Missing key: " & _)
    else
        {}
in
    List.Combine({errors, subErrors}),

LocalDiagnostics = (optional diagnosticsRecord as nullable record) as table =>
    let
        recordToUse = if diagnosticsRecord = null then [] else diagnosticsRecord,
        diagnosticsList = Record.ToTable(recordToUse),
        diagnosticsTable = Table.RenameColumns(diagnosticsList, {{"Name", "Key"}, {"Value", "Message"}})
    in
        diagnosticsTable
        
        in
    [
    ValidateConfiguration = ValidateConfiguration,
    ValidateField = ValidateField,
    LocalDiagnostics = LocalDiagnostics
    ]