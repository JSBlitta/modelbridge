let
// Import GetModelData from Model.pqm
Model = Expression.Evaluate(Text.FromBinary(Extension.Contents("Model.pqm")), #shared),
GetModelData = Model[GetModelData],


GetInfoItems = (endpoints as record, folderId as text) =>
    let
        base_url = endpoints[Core],
        url = base_url & "folders/" & folderId & "/items",
        foldersAsJson = Json.Document(Web.Contents(url)),
        folderTable = Table.FromRecords(
        List.Transform(foldersAsJson, each Record.SelectFields(_, {"id", "projectId", "name", "type"})))
    in
        folderTable,

GetInfoContent = (endpoints as record, folderId as text, fields as nullable text, optional goal as list) as list =>
    let
        base_url = endpoints[Core],
        folderItems = GetInfoItems(endpoints, folderId),
        goals = if goal = null then {} else goal,
       
        selectedFiles = Table.SelectRows(folderItems, each
            Text.Contains([type], "File", Comparer.OrdinalIgnoreCase)
            and Text.EndsWith([name], ".ifc", Comparer.OrdinalIgnoreCase)
            and Text.Contains([name], "info", Comparer.OrdinalIgnoreCase)
        ),

        fileResults = List.Transform(
            Table.ToRecords(Table.SelectColumns(selectedFiles, {"id", "projectId", "name", "type"})),
            each GetModelData(endpoints, _, fields)
        ),

        subfolderResults = List.Combine(
            List.Transform(
                Table.SelectRows(folderItems, each Text.Contains([type], "Folder", Comparer.OrdinalIgnoreCase))[id],
                each @GetInfoContent(endpoints, _, fields, null)
            )
        ),

        combined = List.Combine({fileResults, subfolderResults})
    in
        combined


    // GetInfoContent = (
    //     endpoints as record,
    //     folderId as text,
    //     goal as table
    // ) =>
    //     let
    //         base_url = endpoints[Core],
    //         folderItems = GetFolderItems(endpoints, folderId),
    //         endGoal = if goal = null then {} else goal,
    //         withDataColumn1 = Table.AddColumn(
    //             folderItems,
    //             "Data",
    //             each
    //                 if Text.Contains([type], "Folder", Comparer.OrdinalIgnoreCase) then
    //                     @GetInfoContent(endpoints, [id], goal)
    //                 else if
    //                     Text.Contains([type], "File", Comparer.OrdinalIgnoreCase)
    //                     and (
    //                         Text.EndsWith([name], ".ifc", Comparer.OrdinalIgnoreCase)
    //                         and Text.Contains([name], "info", Comparer.OrdinalIgnoreCase)
    //                     )
    //                 then
    //                     GetModelData(endpoints, [id], [projectId], null, null, "")
    //                 else
    //                    null,
    //             type table
    //         )
    //     in
    //     withDataColumn1
    
    in
    [
GetInfoContent = GetInfoContent
    ]


