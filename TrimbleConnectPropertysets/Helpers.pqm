let
CompanyPropertyset = Json.Document(Extension.Contents("Configuration.json"))[companyConstants][companyPropertyset],
ConnectorSettings  = Json.Document(Extension.Contents("Configuration.json"))[connectorSettings],

Model         = Extension.LoadFunction("Model.pqm"),
GetModelData  = Model[GetModelData],
ifcCollection = Model[ifcCollection],

Organizer            = Extension.LoadFunction("Organizer.pqm"),
TreeFlow             = Organizer[TreeFlow],
TreeChain            = Organizer[TreeChain],
GetProjectLibraryIds = Organizer[GetProjectLibraryIds],

Core = Extension.LoadFunction("Core.pqm"),
GetReleases = Core[GetReleases],
GetReleaseFiles = Core[GetReleaseFiles],
GetFileVersions = Core[GetFileVersions],

Propertyset     = Extension.LoadFunction("Propertyset.pqm"),
GetPSetLibDefs  = Propertyset[GetPSetLibDefs],
GetTrimblePsets = Propertyset[GetTrimblePsets],
GetTrimbleData  = Propertyset[GetTrimbleData],

FileProcessor = (
    row as record,
    endpoints as record,
    checks as record,
    fields as text,
    filterString as nullable text,
    optional selectedAPIs as list
) as table =>
    let
        APIs = {
            {
                row[projectId], "File versions",
                let
                    fileVersions = GetFileVersions(endpoints, row[id]),
                    withData     = Table.AddColumn(fileVersions, "Data", each ifcCollection(endpoints, _, fields, filterString)),
                    withIsLeaf   = Table.AddColumn(withData, "IsLeaf", each true, type logical),
                    navTable     = Table.ToNavigationTable(withIsLeaf, {"versionId"}, "name", "Data", "name", "name", "IsLeaf")
                in
                    navTable,
                "Folder", false
            },
            {
                row[projectId], "Model API",
                [#"Get IFC data" = () => ifcCollection(endpoints, row, fields, filterString)],
                "Record", true
            },
            {
                row[projectId],
                if checks[Organizer API] = false then Extension.LoadString("NoStructuresFound") else "Organizer API",
                if checks[Organizer API] = false then
                    Extension.LoadString("NoStructuresFound")
                else
                    [#"Get organizational structures" = () => TreeFlow(endpoints, row[projectId], checks[Organizer API])],
                "Record", true
            },
            {
                row[projectId],
                if checks[PropertySet API] = false then Extension.LoadString("NoLibrariesFound") else "PropertySet API",
                if checks[PropertySet API] = false then
                    Extension.LoadString("NoLibrariesFound")
                else
                    [#"Get entities with Trimble propertysets" = () => GetTrimbleData(endpoints, row[projectId], checks[PropertySet API])],
                "Record", true
            }
        },
        recordAPI = [Core = APIs{0}, Model = APIs{1}, Organizer = APIs{2}, PropertySet = APIs{3}],
       finalRows = if selectedAPIs = null then APIs else Record.ToList(Record.SelectFields(recordAPI, selectedAPIs)),

        navTable = Table.ToNavigationTable(
            #table({"ProjectId", "Name", "Data", "Type", "IsLeaf"}, finalRows),
            {"Name"}, "Name", "Data", "Type", "Name", "IsLeaf"
        )
    in
        navTable,

EnrichWithReleases = (projectsTable as table, endpoints as record, fields as text, filterString as text) as table =>
    let
    withReleaseColumn = Table.AddColumn(projectsTable, "Data", each 
        let
        projectId = [id],
        releases = GetReleases(endpoints, projectId, [checks])
    in
        if not Table.IsEmpty(releases)
        then let
            projectReleases  = Table.AddColumn(releases, "Data", each 
                GetReleaseFiles(endpoints, [id], [projectId], [checks]),
                type table
            ),
            releasesWithData = Table.TransformColumns(projectReleases, {"Data", each
                let
                withData = Table.AddColumn(_, "Data", each
                if Text.Proper([type]) = "File" and IsValidModelFileType([name])
                then
                    FileProcessor(_, endpoints, [checks], fields, filterString, {"Model","Organizer", "PropertySet"})
                else
                    Extension.LoadString("FiletypeUnsupportedI") &
                    Text.AfterDelimiter([name], ".", {0, RelativePosition.FromEnd}) &
                    Extension.LoadString("FiletypeUnsupportedII"),
                    type table
                ),
                withIsLeaf = Table.AddColumn(withData, "IsLeaf", each false, type logical),
                nav        = Table.ToNavigationTable(withIsLeaf, {"id"}, "name", "Data", "type", "name", "IsLeaf")
            in
                nav
            }),
            withIsLeaf = Table.AddColumn(releasesWithData, "IsLeaf", each false, type logical),
            nav = Table.ToNavigationTable(withIsLeaf, {"id"}, "name", "Data", "type", "name", "IsLeaf")
        in
            nav
    else
        null,
type table
),
Filtered = Table.SelectRows(withReleaseColumn, each IsNotNullOrEmpty([Data]))       
in
Filtered,

GetAll = (endpoints as record,
        modelId as text,
        projectId as text,
        fields as nullable text,
        optional libIds as list,
        optional versionId as text,
        optional filterString as text)
    => let
    // Create cache key for memoization
    cacheKey = Text.Combine({
        "getAll",
        modelId,
        projectId,
        Text.From(fields),
        Text.Combine(List.Transform(libIds, each Text.From(_)), ","),
        Text.From(versionId),
        Text.From(filterString)
    }, "|"),
    
    model_API_list = GetModelData(endpoints, modelId, projectId, fields, versionId, filterString),
    
    // Create a proper table from the list
    model_API = if model_API_list is list then
                   let
                       // Create a table with GUID column
                       entitiesTable = Table.FromList(
                           model_API_list,
                           Splitter.SplitByNothing(),
                           {"Entity"},
                           null,
                           ExtraValues.Error
                       ),
                       // Extract GUID from each entity
                       withGUID = Table.AddColumn(
                           entitiesTable,
                           "GUID",
                           each if [Entity] is record and Record.HasFields([Entity], "id") then
                                   [Entity][id]
                                else
                                   null
                       )
                   in
                       withGUID
                else
                   model_API_list,
    
    // Check if we need to get property set data
    needPsetData = libIds <> null and
                  (libIds is list and not List.IsEmpty(libIds)) and
                  not (libIds is text),
    
    // Get data from PropertySet API only if library IDs are available
    pset_API = if needPsetData then
                  Table.Buffer(GetPSetLibDefs(endpoints, projectId, libIds))
               else
                  null,
                  
    // Get property set entities if definitions are available
    psetEntities = if pset_API = null then
                       null
                    else
                       // Don't try to pass ifcDefs since we're not sure of the structure
                       Table.Buffer(GetTrimblePsets(endpoints, projectId, pset_API)),
    
    // Get data from Organizer API
    treeChain = Table.Buffer(TreeChain(endpoints, projectId)),
    
    // Merge Model and PropertySet data on GUID if PropertySet data is available
    mergeModelPset = if psetEntities = null then
                        model_API
                     else if psetEntities is list and List.Count(psetEntities) > 0 and psetEntities{0} is table then
                        Table.Buffer(Table.Join(
                            model_API,
                            "GUID",
                            psetEntities{0},
                            "Link",
                            JoinKind.LeftOuter
                        ))
                     else
                        // Return model_API if psetEntities is not in the expected format
                        model_API,
    
    // Ensure all GUIDs remain unique after merging
    uniqueGUIDs = Table.Buffer(Table.Distinct(mergeModelPset, {"GUID"})),
    
    // Create a final table with all data
    finalTable = if uniqueGUIDs is table then
                    Table.Buffer(Table.AddColumn(
                        uniqueGUIDs,
                        "OrganizationData",
                        each treeChain,
                        type record
                    ))
                 else
                    // Handle case where uniqueGUIDs is not a table
                    #table({"GUID", "OrganizationData"}, {{null, treeChain}})
    in
    finalTable,

RemoveFrnPrefix = (inputText as text) as text =>
    if Text.StartsWith(inputText, "frn:") then
        let
            parts = Text.Split(inputText, ":"),
            remainder = List.Skip(parts, 2)
        in
            Text.Combine(remainder, ":")
    else
        inputText,

NormalizeName = (name) => Text.Proper(Text.Trim(Text.TrimStart((name), "-"))),

IsNullOrEmpty    = (x as nullable any) as logical => x = null or x = "",
IsNotNullOrEmpty = (x as nullable any) as logical => not IsNullOrEmpty(x),

IsValidModelFileType = (name as text) as logical =>
    (
        Text.EndsWith(name, ".ifc", Comparer.OrdinalIgnoreCase) or
        Text.EndsWith(name, ".ifczip", Comparer.OrdinalIgnoreCase) or
        Text.EndsWith(name, ".trb", Comparer.OrdinalIgnoreCase)
    ),

DecodeUrl = (data as text) as text => Uri.Parts("http://decode?urlencoded=" & data)[Query][urlencoded],

FilterBuilder = (
    optional FilterFunctions as list,
    optional FilterProperties as list,
    optional FilterValues as text,
    optional FilterFreeform as text
) =>
let
    encodeProperty = (prop as text) => Text.Replace(prop, " ", "_x0020_"),
    formatValue = (val as any) =>
        if Value.Is(val, type text) then
            "'" & Text.Replace(val, "'", "''") & "'"
        else if Value.Is(val, type datetimezone) then
            "'" & Text.Replace(Text.From(val), "+", "%2B") & "'"
        else if Value.Is(val, type duration) then
            "duration'" & Text.From(val) & "'"
        else
            Text.From(val),            
    BuildExpression = (func as text, prop as text, val as text) =>
        let
            EncodedProp = encodeProperty(prop),
            ValueParts = if Text.Contains(val, ",") then  Text.Split(val, ",") else {val},
            Expressions = List.Transform(ValueParts, each
                let
                    Expr = 
                        if func = "contains" then
                            "contains(toupper(" & EncodedProp & ")," & formatValue(Text.Upper(_)) & ")"
                        else if func = "does not contain" then
                            "not contains(toupper(" & EncodedProp & ")," & formatValue(Text.Upper(_)) & ")"
                        else if func = "starts with" then
                            "startswith(toupper(" & EncodedProp & ")," & formatValue(Text.Upper(_)) & ")"
                        else if func = "does not start with" then
                            "not startswith(toupper(" & EncodedProp & ")," & formatValue(Text.Upper(_)) & ")"
                        else if func = "ends with" then
                            "endswith(toupper(" & EncodedProp & ")," & formatValue(Text.Upper(_)) & ")"
                        else if func = "does not end with" then
                            "not endswith(toupper(" & EncodedProp & ")," & formatValue(Text.Upper(_)) & ")"
                       
                        else
                            "toupper(" & EncodedProp & ") eq " & formatValue(Text.Upper(_))
                in
                    Expr
            ),
            joinExpressions = "(" & Text.Combine(Expressions, " or ") & ")"
        in
            if List.Count(ValueParts) = 1 then 
                Text.Replace(joinExpressions, "(", "") & Text.Replace(Text.End(joinExpressions, 1), ")", "")
            else 
                joinExpressions,
    ValuesList = if IsNotNullOrEmpty(FilterValues) and Text.Contains(FilterValues, "|") then Text.Split(FilterValues, "|") else {FilterValues},
    finalFilter =
        if IsNotNullOrEmpty(FilterFreeform) and FilterFreeform <> "" then
            "&$filter=" & FilterFreeform
        else if IsNotNullOrEmpty(FilterFunctions) and IsNotNullOrEmpty(FilterProperties) and List.Count(FilterFunctions) > 0 and List.Count(FilterProperties) > 0 then
            let             
                Expressions = if IsNotNullOrEmpty(FilterFunctions) and IsNotNullOrEmpty(FilterProperties) and IsNotNullOrEmpty(ValuesList)  then
                    List.Generate(
                        () => [idx = 0, expr = ""],
                        each [idx] < List.Min({List.Count(FilterFunctions), List.Count(FilterProperties), List.Count(ValuesList)}),
                        each [
                            idx = [idx] + 1,
                            expr = BuildExpression(
                                FilterFunctions{[idx]}, 
                                FilterProperties{[idx]}, 
                                if [idx] < List.Count(ValuesList) then ValuesList{[idx]} else ""
                            )
                        ],
                        each [expr]
                    )
                else
                    {},
                CombinedResult = Text.Combine(Expressions, " and ")
            in
                "&$filter=" & CombinedResult
        else
            ""
in
    finalFilter,


GenerateSchema = (psetDefs as table) as list => 

let  
    filtered       = Table.SelectColumns(psetDefs, {"prop_name", "prop_type"}),
    renamed        = Table.RenameColumns(filtered, {{"prop_name", "PropertyName"}, {"prop_type", "DataType"}}),
    nonNull        = Table.SelectRows(renamed, each IsNotNullOrEmpty([DataType])),
    distinct       = Table.Distinct(nonNull, {"PropertyName"}),
    withNormalized = Table.AddColumn(distinct, "Name", each NormalizeName([PropertyName])),
    unique         = Table.Distinct(Table.SelectColumns(withNormalized, {"Name", "DataType"}), {"Name"}),
    addGUID        = Table.InsertRows(unique, 0, {[Name = "GUID", DataType = "string"]}),

   toType = (dtype as nullable any) as type =>
        let
            dtypeText = if dtype = null then "" else Text.Lower(Text.From(dtype))
        in
            if dtype = null or dtypeText = "" then type any
            else if Text.Contains(dtypeText, "integer", Comparer.OrdinalIgnoreCase) then Int64.Type
            else if List.MatchesAny({"number", "mass", "leng", "area", "volume", "angl"}, each Text.Contains(dtypeText, _, Comparer.OrdinalIgnoreCase)) then type number
            else if Text.Contains(dtypeText, "bool", Comparer.OrdinalIgnoreCase) then type nullable logical
            else if Text.Contains(dtypeText, "string", Comparer.OrdinalIgnoreCase) then type text
            else type any,

    schemaList = List.Transform(
        Table.ToRecords(addGUID),
        each 
            let
                Name = [Name],
                dtype = [DataType],
                Type = try toType(dtype) otherwise type any
            in
                {Name, Type}
    )
    
in
    schemaList,

SchemaTransformTable = (table as table, schema as table, optional enforceSchema as number, optional culture as nullable text) as table =>
    try
    let
EnforceSchema.Strict = 1,
EnforceSchema.IgnoreExtraColumns = 2,
EnforceSchema.IgnoreMissingColumns = 3, 
        _enforceSchema = if (IsNotNullOrEmpty(enforceSchema)) then enforceSchema else EnforceSchema.Strict,
        EnforceTypes = (table as table, schema as table, optional culture as nullable text) as table =>
            let
        culture = if culture = null then null else culture,
         map = (t) => if Type.Is(t, type list) or Type.Is(t, type record) or t = type any then null else t,
         mapped = Table.TransformColumns(schema, {"Type", map}),
         omitted = Table.SelectRows(mapped, each IsNotNullOrEmpty([Type])),
         existingColumns = Table.ColumnNames(table),
         removeMissing = Table.SelectRows(omitted, each List.Contains(existingColumns, [Name])),
         primativeTransforms = Table.ToRows(removeMissing),
         numberColumns = Table.SelectRows(removeMissing, each Type.Is([Type], type number))[Name],
            withFixedDecimals = if List.IsEmpty(numberColumns) then table else
                Table.TransformColumns(table, 
                    List.Transform(numberColumns, each {_, (x) => Number.RoundTowardZero(Number.From(Text.Replace(Text.From(x), ".", ",")), ConnectorSettings[decimalPlaces])})),
            withAllTypes = Table.TransformColumnTypes(withFixedDecimals, primativeTransforms, culture)
            in
            withAllTypes,
        SchemaToTableType = (schema as table) as type =>
            let
                toList = List.Transform(schema[Type], (t) => [Type=t, Optional=false]),
                toRecord = Record.FromList(toList, schema[Name]),
                toType = Type.ForRecord(toRecord, false)
            in
                type table (toType),
        schemaNames = schema[Name],
        foundNames = Table.ColumnNames(table),
        addNames = List.RemoveItems(schemaNames, foundNames),
        extraNames = List.RemoveItems(foundNames, schemaNames),
        tmp = Text.NewGuid(),
        added = Table.AddColumn(table, tmp, each []),
        expanded = Table.ExpandRecordColumn(added, tmp, addNames),
        result = if List.IsEmpty(addNames) then table else expanded,
        fullList =
            if (_enforceSchema = EnforceSchema.Strict) then
                schemaNames
            else if (_enforceSchema = EnforceSchema.IgnoreMissingColumns) then
                foundNames
            else
                schemaNames & extraNames,
        reordered = Table.SelectColumns(result, fullList, MissingField.Ignore),
        enforcedTypes = EnforceTypes(reordered, schema, culture),
        withType = if (_enforceSchema = EnforceSchema.Strict) then Value.ReplaceType(enforcedTypes, SchemaToTableType(schema)) else enforcedTypes
    in
        withType otherwise error "SchemaTransformTable",

 TransformRecord = 
    [Product =
(input as list) => let
     toTable = Table.FromList(input, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
    expandProduct = Table.ExpandRecordColumn(toTable, "Column1", {"id", "product"}, {"product_id", "product"}),
    expandProduct2 = Table.ExpandRecordColumn(expandProduct, "product", {"name", "description", "objectType", "ownerIdx", "historyIdx"}, {"product_name", "description", "objectType", "ownerIdx", "historyIdx"})
in
    Table.Buffer(expandProduct2), 
    BoundingBox =
(input as list) => let
     toTable = Table.FromList(input, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
    expandColumn = Table.ExpandRecordColumn(toTable, "Column1", {"id", "boundingBox"}, {"boundingBox_id", "boundingBox"}),
    expandBoundinbx = Table.ExpandRecordColumn(expandColumn, "boundingBox", {"min", "max", "extents", "center"}, {"min", "max", "extents", "center"}),
    expandMax = Table.ExpandRecordColumn(expandBoundinbx, "max", {"x", "y", "z"}, {"max.x", "max.y", "max.z"}),
    wxpandContents = Table.ExpandRecordColumn(expandMax, "extents", {"x", "y", "z"}, {"extents.x", "extents.y", "extents.z"}),
    expandCenter = Table.ExpandRecordColumn(wxpandContents, "center", {"x", "y", "z"}, {"center.x", "center.y", "center.z"}),
    expandMin = Table.ExpandRecordColumn(expandCenter, "min", {"x", "y", "z"}, {"min.x", "min.y", "min.z"})
in
    Table.Buffer(expandMin),
    HierarchyInfo =
(input as list) => let
     toTable = Table.FromList(input, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
    expand1 = Table.ExpandRecordColumn(toTable, "Column1", {"id", "hierarchyInfo"}, {"hierarchyInfo_id", "hierarchyInfo"}),
    expandedHierarchyInfo = Table.ExpandListColumn(expand1, "hierarchyInfo"),
    expandedHierarchyInfo1 = Table.ExpandRecordColumn(expandedHierarchyInfo, "hierarchyInfo", {"type", "count"}, {"type", "count"}),
    bufferForPivot = Table.Buffer(expandedHierarchyInfo1),
    Pivot = Table.Pivot(bufferForPivot, List.Distinct(bufferForPivot[#"type"]), "type", "count")
in
    Table.Buffer(Pivot),  
    Type =
(input as list) => let
     toTable = Table.FromList(input, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
    expandType = Table.ExpandRecordColumn(toTable, "Column1", {"id", "type"}, {"type_id", "ifc_type"})
in
    Table.Buffer(expandType),
    LayerIds =
(input as list) => let
     toTable = Table.FromList(input, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
    expandedLayerids = Table.ExpandRecordColumn(toTable, "Column1", {"id", "layerIds"}, {"layerIds_id", "layerIds"}),
    expandLayer = Table.ExpandListColumn(expandedLayerids, "layerIds")
in
   Table.Buffer(expandLayer)],

MergeEntitiesWithIFCPSetDefs = (entities as list, psetdefs as list)
 => let
    // Get connector settings for filtering
    ConnectorSettings = Json.Document(Extension.Contents("Configuration.json"))[connectorSettings],
    userPsetList = ConnectorSettings[propertysetToKeep] ?? {},
    propertySetsDiscard = ConnectorSettings[propertySetsDiscard] ?? {},
    
    // Filter property set definitions early if possible
    filteredPsetDefs = if not List.IsEmpty(userPsetList) then
                          List.Select(psetdefs, each List.Contains(userPsetList, _[name]))
                       else if not List.IsEmpty(propertySetsDiscard) then
                          List.Select(psetdefs, each not List.Contains(propertySetsDiscard, _[name]))
                       else
                          psetdefs,
    
    // Create definitions lookup table with buffering
    defsTable = Table.Buffer(Table.Combine(
        List.Transform(filteredPsetDefs, each
            let
                idx = _[idx],
                props = _[props],
                propsTable = Table.FromRecords(props),
                withIdx = Table.AddColumn(propsTable, "psetidx", each idx)
            in
                withIdx
        )
    )),
    
    // Create property name lookup for faster access
    propNameLookup = Record.FromList(
        List.Transform(
            Table.ToRecords(Table.SelectColumns(defsTable, {"psetidx", "def_index", "prop_name"})),
            each _[prop_name]
        ),
        List.Transform(
            Table.ToRecords(Table.SelectColumns(defsTable, {"psetidx", "def_index"})),
            each Text.From(_[psetidx]) & "_" & Text.From(_[def_index])
        )
    ),
    
    // Process entities with buffering for performance
    nestedMerge = List.Buffer(List.Transform(entities, each
        let
            entity = _,
            psets = entity[psets],
            
            // Filter property sets early if possible
            filteredPsets = if not List.IsEmpty(userPsetList) then
                               List.Select(psets, each List.Contains(userPsetList, _[pset_name]))
                            else if not List.IsEmpty(propertySetsDiscard) then
                               List.Select(psets, each not List.Contains(propertySetsDiscard, _[pset_name]))
                            else
                               psets,

            // Process property sets
            newPsets = List.Transform(filteredPsets, each
                let
                    pset = _,
                    idx = pset[idx],
                    values = pset[values],
                    
                    // Process values with optimized approach
                    processedValues = List.Transform(
                        values,
                        each
                            let
                                value = _,
                                valueIdx = value[value_index],
                                lookupKey = Text.From(idx) & "_" & Text.From(valueIdx),
                                propName = Record.FieldOrDefault(propNameLookup, lookupKey, null),
                                
                                // Add property name to value record
                                updatedValue = Record.Combine({
                                    value,
                                    [prop_name = propName]
                                })
                            in
                                updatedValue
                    ),
                    
                    // Update property set with processed values
                    updatedPset = Record.TransformFields(pset, {{"values", each processedValues}})
                in
                    updatedPset
            ),

            // Rebuild entity with updated property sets
            updatedEntity = Record.TransformFields(entity, {{"psets", each newPsets}})
        in
            updatedEntity
    )),
    
    // Get fields present in entities
    fieldsPresent = Record.FieldNames(nestedMerge{0}),
    
    // Convert to table
    toTable = Table.FromList(nestedMerge, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
    expandAll = Table.ExpandRecordColumn(toTable, "Column1", {"id", "psets"}, {"id", "psets"}),
    unlistPsets = Table.ExpandListColumn(expandAll, "psets"),
    expandPsets = Table.ExpandRecordColumn(unlistPsets, "psets", {"idx", "pset_name", "values"}, {"idx", "pset_name", "values"}),
    
    // Apply property set filtering
    hasPsetsToKeep = not List.IsEmpty(userPsetList) and
                     List.NonNullCount(List.Intersect({List.Distinct(expandPsets[pset_name]), userPsetList})) > 0,
    psetToKeep = if hasPsetsToKeep
                 then Table.SelectRows(expandPsets, each List.Contains(userPsetList, [pset_name]))
                 else expandPsets,
                 
    // Expand values
    unlistPsetValues = Table.ExpandListColumn(psetToKeep, "values"),
    expandValues = Table.ExpandRecordColumn(unlistPsetValues, "values", {"prop_value", "value_index", "prop_name"}, {"prop_value", "value_index", "prop_name"}),
    
    // Select and clean columns
    selectColumns = Table.SelectColumns(expandValues, {"id", "prop_name", "prop_value"}),
    nullSafingValues = Table.ReplaceValue(selectColumns, null, "[no value found]", Replacer.ReplaceValue, {"prop_value"}),
    nullSafingNames = Table.ReplaceValue(nullSafingValues, null, "[no name found]", Replacer.ReplaceValue, {"prop_name"}),
    
    // Buffer before pivot for performance
    bufferBeforePivot = Table.Buffer(nullSafingNames),
    
    // Create distinct list of property names for pivot
    distinctPropNames = List.Buffer(List.Distinct(bufferBeforePivot[prop_name])),
    
    // Pivot table
    baseTable = Table.Buffer(Table.Pivot(bufferBeforePivot, distinctPropNames, "prop_name", "prop_value")),
    
    // Rename ID to GUID
    renamedTable = Table.RenameColumns(baseTable, {{"id", "GUID"}}),
    
    // Apply transforms if needed
    transformNames = Record.FieldNames(TransformRecord),
    matchingTransforms = List.Buffer(List.Intersect({fieldsPresent, transformNames}, Comparer.OrdinalIgnoreCase)),
    
    // Apply transforms in parallel if possible
    finalTable = if List.IsEmpty(matchingTransforms) then
                    renamedTable
                 else
                    let
                        // Function to apply transform
                        ApplyTransform = (field as text) =>
                            let
                                actualField = List.First(
                                    List.Select(
                                        Record.FieldNames(TransformRecord),
                                        each Text.Lower(_) = Text.Lower(field)
                                    ),
                                    null
                                ),
                                fn = if IsNotNullOrEmpty(actualField) then
                                        Record.Field(TransformRecord, actualField)
                                     else
                                        null,
                                result = if IsNotNullOrEmpty(fn) then
                                            Table.Buffer(fn(nestedMerge))
                                         else
                                            null
                            in
                                [Field = field, Table = result],
                        
                        // Apply transforms
                        transformResults = List.Buffer(List.Transform(
                            matchingTransforms,
                            ApplyTransform
                        ) meta [List.TransformMany.ParallelHint = true]),
                        
                        // Join results
                        joinedTable = List.Accumulate(
                            transformResults,
                            renamedTable,
                            (state, transformResult) =>
                                if transformResult[Table] = null then
                                    state
                                else
                                    let
                                        fieldName = transformResult[Field],
                                        nextTable = transformResult[Table],
                                        joinedName = fieldName & "_joined",
                                        joined = Table.NestedJoin(
                                            state,
                                            "GUID",
                                            nextTable,
                                            fieldName & "_id",
                                            joinedName,
                                            JoinKind.LeftOuter
                                        )
                                    in
                                        joined
                        )
                    in
                        joinedTable
in
    finalTable,

Table.ToNavigationTable = (
    table as table,
    keyColumns as list,
    nameColumn as text,
    dataColumn as text,
    itemKindColumn as text,
    itemNameColumn as text,
    isLeafColumn as text
) as table =>
    let
        tableType    = Value.Type(table),
        newTableType = Type.AddTableKey(tableType, keyColumns, true) meta [
            NavigationTable.NameColumn     = nameColumn,
            NavigationTable.DataColumn     = dataColumn,
            NavigationTable.ItemKindColumn = itemKindColumn,
            Preview.DelayColumn            = itemNameColumn,
            NavigationTable.IsLeafColumn   = isLeafColumn
        ],
        navigationTable = Value.ReplaceType(table, newTableType)
    in
        navigationTable
      
        
in
[
    FileProcessor                = FileProcessor,
    EnrichWithReleases           = EnrichWithReleases,
    FilterBuilder                = FilterBuilder,
    MergeEntitiesWithIFCPSetDefs = MergeEntitiesWithIFCPSetDefs,
    GenerateSchema               = GenerateSchema,
    IsValidModelFileType         = IsValidModelFileType,
    SchemaTransformTable         = SchemaTransformTable,
    NormalizeName                = NormalizeName,
    Table.ToNavigationTable      = Table.ToNavigationTable,
    GetAll                       = GetAll,
    DecodeUrl                    = DecodeUrl,
    RemoveFrnPrefix              = RemoveFrnPrefix,
    IsNullOrEmpty                = IsNullOrEmpty,
    IsNotNullOrEmpty             = IsNotNullOrEmpty
]