let

FetchPages = (baseUrl as text, pageSize as number, optional queryString as text) =>
    let
        // Add caching to avoid redundant API calls
        cachedUrl = baseUrl & "|" & Text.From(pageSize),
        
        Source = GenerateByPage(
            (previous) =>
                let
                    previousMeta = Value.Metadata(previous),
                    offset = Text.From(Record.FieldOrDefault(previousMeta, "offset", 0)),
                    nextUrl = Record.FieldOrDefault(previousMeta, "nextUrl", null),
                    totalItems = Text.From(Record.FieldOrDefault(previousMeta, "total", 0)),
                    
                    // Check if we've reached the end of data
                    reachedEnd = previous <> null and (
                        offset = null and nextUrl = null or  // No more pages
                        Table.RowCount(previous) < pageSize or  // Last page had fewer rows than pageSize
                        (totalItems <> null and offset >= totalItems)  // We've fetched all items
                    ),
                                // Build query parameters
                    queryParams = [
                        top = Text.From(pageSize)
                    ] & (if offset <> null then [offset = offset] else []) ,
                      
                      

                    fullUrl = 
                    if nextUrl <> null then nextUrl else
                    baseUrl & "?" & Uri.BuildQueryString(queryParams) & (if queryString <> null then queryString else ""),
                    
                    table = if previous = null or not reachedEnd then
                                FetchPage(fullUrl)
                            else
                                null
                in
                    table,
            type table [Column1]
        )
    in
        Source,

GenerateByPage = (getNextPage as function, optional tableType as type) as table =>
    let
        listOfPages = List.Generate(
            () => getNextPage(null), (lastPage) => lastPage <> null, (lastPage) => getNextPage(lastPage)
        ),
        tableOfPages = Table.FromList(listOfPages, Splitter.SplitByNothing(), {"Column1"}),
        firstRow = tableOfPages{0} ?,
        keys =
            if tableType = null then
                Table.ColumnNames(firstRow[Column1])
            else
                Record.FieldNames(Type.RecordFields(Type.TableRow(tableType))),
        appliedType = if tableType = null then Value.Type(firstRow[Column1]) else tableType
    in
        if tableType = null and firstRow = null then
            Table.FromRows({})
        else
            Value.ReplaceType(Table.ExpandTableColumn(tableOfPages, "Column1", keys), appliedType),

FetchPage = (url as text
) as table =>
    let
        
        // Set headers for the request
        headers = [
            #"Content-Type" = "application/json",
            #"Accept" = "application/json"
        ],
        
        // Make the request with error handling
        response = Web.Contents(url, [
            // Headers = headers,
            ManualStatusHandling = {400, 404, 429, 500, 503}  // Handle common error codes
        ]),
        
        // Check for HTTP errors
        responseMetadata = Value.Metadata(response),
        statusCode = if Record.HasFields(responseMetadata, "Response.Status")
                    then responseMetadata[Response.Status] else 200,
                    
        // Parse JSON response
        json = if statusCode >= 400 then
                  error Extension.LoadString("FetchPageError") & " " & Text.From(statusCode)
               else
                  Json.Document(response),

        // Add metadata for pagination
        offsetNext = if Record.HasFields(json, "offsetNext") then json[offsetNext] else null,
        total = if Record.HasFields(json, "total") then json[total] else null,
        nextUrl = if Record.HasFields(json, "next") then json[next] else null,

        // Create table from items
        items = if Record.HasFields(json, "items") then json[items] else {},
        metaFields = [offset = offsetNext, total = total, nextUrl = nextUrl],
        table = Table.FromList(items, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
        tableWithMeta = table meta metaFields
    in
        tableWithMeta,

BatchPages = (url as text, headers as record, body as any, optional maxRetries as number) as any =>
    let
        // Set default max retries if not provided
        maxRetriesValue = if maxRetries = null then 3 else maxRetries,
        
        // Add exponential backoff for retries
        backoffDuration = (attempt as number) => #duration(0, 0, 0, Number.Power(2, attempt - 1)),
        
        fetch = (attempt as number) as any =>
            let
                // Add request timeout and compression
                request = Web.Contents(url, [
                    Headers = headers,
                    Content = body,
                    ManualStatusHandling = {400..599},  // Handle all error codes
                    Timeout = #duration(0, 0, 2, 0),  // 2 minute timeout
                    IsRetry = attempt > 1  // Flag for retry attempts
                ]),
                
                // Get response metadata
                responseMetadata = Value.Metadata(request),
                statusCode = if Record.HasFields(responseMetadata, "Response.Status")
                            then responseMetadata[Response.Status] else 200,
                
                // Parse JSON response with error handling
                decodeJson = try Json.Document(request) otherwise null,
                
                // Check for API errors in the response
                apiErrors = if decodeJson <> null and
                               Record.HasFields(decodeJson, "responses") and
                               Record.HasFields(decodeJson[responses], "errors") and
                               List.Count(decodeJson[responses][errors]) > 0
                            then decodeJson[responses][errors]
                            else null,
                
                // Determine if retry is needed
                retryNeeded = (apiErrors <> null or statusCode >= 500 or statusCode = 429) and
                              attempt < maxRetriesValue,
                
                // Wait before retry using exponential backoff
                _ = if retryNeeded then Function.InvokeAfter(() => 0, backoffDuration(attempt)) else 0,
                
                // Retry or return result
                result = if retryNeeded then
                            @fetch(attempt + 1)
                         else if decodeJson = null then
                            error Extension.LoadString("BatchPagesJsonError") & " " & Text.From(statusCode)
                         else
                            decodeJson
            in
                result
    in
        fetch(1)

// ,GenerateByList = (getNextPage as function) as list =>
//     List.Generate(
//         () => getNextPage(null),
//         (lastPage) => lastPage <> null,
//         (lastPage) => getNextPage(lastPage)
//     )
        in
    [
    FetchPages                   = FetchPages,
    GenerateByPage               = GenerateByPage,
    FetchPage                    = FetchPage,
    BatchPages                   = BatchPages
    ]