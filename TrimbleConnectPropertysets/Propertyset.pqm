let
    FetchPages      = Extension.LoadFunction("Pagination.pqm")[FetchPages],
    Helpers         = Extension.LoadFunction("Helpers.pqm"),
    NormalizeName   = Helpers[NormalizeName],
    RemoveFrnPrefix = Helpers[RemoveFrnPrefix],
    GenerateSchema  = Helpers[GenerateSchema],

GetTrimbleData = (endpoints as record, projectId as text, libIds as list) =>
let
    
    // Create a cache key for memoization
    cacheKey = projectId & "_" & Text.Combine(List.Transform(libIds, each Text.From(_)), ","),
    
    // Fetch and process the data with proper error handling
    result = try
                let
                    // Get property set definitions
                    defsTable = GetPSetLibDefs(endpoints, projectId, libIds),

                    typeSchema = GenerateSchema(defsTable),

                    // Get property set data - ensure defsTable is a table
                    trimbleData = GetTrimblePsets(endpoints, projectId, defsTable)
                        
                in
                    trimbleData
             otherwise
                error Extension.LoadString("ErrorFetchingPropertySetData")
in
    result,

GetPSetLibDefs = (endpoints as record, projectId as text, libIds as list) as table =>
    let
        defsList = try  List.Combine(
            List.Transform(
                libIds,
                each
                    let
                        url = endpoints[Propertyset] & "/libs/" & _ & "/defs",
                        defsResponse = FetchPages(url, 200),
                        items = Table.Column(defsResponse, "Column1"),
                        processedItems = List.Transform(items, each
                            let   
                                version = [v],
                                libId = [libId],
                                defId = [id],
                                PSetName = [i18n][#"en-US"][name],
                                SchemaProps = [schema][props],
                                EnUsProps = [i18n][#"en-US"][props],
                                PropKeys = List.Buffer(Record.FieldNames(SchemaProps)),
                                PropRecords = 
    let
        groupedProps = List.Buffer(
            List.Transform(PropKeys, (PropKey) =>
                let
                    PropDetails = Record.Field(SchemaProps, PropKey),
                    // Get the property name, falling back to the key if not found
                    RawPropName =  Record.Field(EnUsProps, PropKey) ,
                    
                    // Make property name unique by checking for duplicates
                    UniquePropName =
                    try
                        let
                            // Find all properties with the same name
                            duplicateNames =
                                List.Select(
                                    PropKeys,
                                    (k) => Text.From(try Record.Field(EnUsProps, k) otherwise k) = Text.From(RawPropName)
                                )
                        in
                            // If there are duplicates, append the property set name to make it unique
                            if List.Count(duplicateNames) > 1 then
                                RawPropName & "_" & PSetName
                            else
                                RawPropName
                    otherwise
                        // Fallback if the check fails
                        RawPropName & "_" & PSetName
                                in
                    [
                        version = version,
                        libId = libId,
                        defId = defId,
                        PSetName = PSetName,
                        PropId = PropKey,
                        prop_name = UniquePropName,
                        prop_type = PropDetails[type],
                        Description = try PropDetails[description] otherwise "",
                        Enum = try PropDetails[enum] otherwise ""
                    ]  
        ))
    in
        groupedProps
                            in
                                PropRecords
                        ) 
                    in
                        List.Combine(processedItems)
            )
        ) otherwise error "defslist",
        FinalTable = Table.FromRecords(defsList),
    // Group by property name to find duplicates
    WithDeduplicatedNames =
        Table.Group(
            FinalTable,
            {"prop_name"},
            {
                {"AllRows", each
                    let
                        rows = _,
                        // Check if we have duplicate property names
                        needsRename = Table.RowCount(rows) > 1,
                        
                        // If duplicates exist, append the property set name to make each unique
                        updated = if needsRename then
                            Table.FromRecords(
                                Table.TransformRows(
                                    rows,
                                    (row) => Record.TransformFields(
                                        row,
                                        {{"prop_name", (p) => p & "_" & row[PSetName]}}
                                    )
                                )
                            )
                        else
                            rows
                    in
                        updated
                , type table}
            }
        ),
    
    // Combine all rows back into a single table
    FinalCleanTable = Table.Combine(WithDeduplicatedNames[AllRows])
    in
        FinalCleanTable,

GetTrimblePsets = (endpoints as record, projectId as text, psetDefs as table) =>
let
    uniquePairs =   Table.Distinct(Table.SelectColumns(psetDefs, {"libId", "defId"})),
    entitiesList = List.Transform(
      try  Table.ToRecords(uniquePairs) otherwise error "entitieslist",
        each
            let
                rec = _,
                libId = try Record.Field(rec, "libId") otherwise error "Missing field 'libId' in record: " & Text.From(rec),
                defId = try Record.Field(rec, "defId") otherwise error "Missing field 'defId' in record: " & Text.From(rec),
                url = endpoints[Propertyset] & "/libs/" & libId & "/defs/" & defId & "/psets",

                // Try fetching; null on failure to allow filtering later
                rawTable =  FetchPages(url, 200) ,

                entitiesTable = if rawTable <> null and Table.HasColumns(rawTable, "Column1") then rawTable else null,

                expanded = if entitiesTable <> null then
                    Table.ExpandRecordColumn(
                        entitiesTable,
                        "Column1",
                        List.Distinct(
                            List.Combine(
                                List.Transform(
                                    entitiesTable[Column1],
                                    each if _ is record then Record.FieldNames(_) else {}
                                )
                            )
                        ) 
                    )
                else null,

                propNames =  if expanded <> null and Table.HasColumns(expanded, "props") then
                    List.Distinct(
                        List.Combine(
                            List.Transform(
                                expanded[props],
                                each if _ is record then Record.FieldNames(_) else {}
                            )
                        )
                    ) 
                else {} ,

                withProps =
                    Table.ExpandRecordColumn(expanded, "props", propNames, propNames),


                cleaned =  Table.TransformColumns(withProps, {{"link", RemoveFrnPrefix}}) 
               
            in
                cleaned 
    ),

    // Remove any null tables (bad fetches)
    combinedTable = Table.Combine(List.Select(entitiesList, each _ <> null)),
     renames = List.Transform(
        Table.ToRecords(Table.SelectColumns(psetDefs, {"PropId", "prop_name"})),
        each {_[PropId], _[prop_name]}
    ),
        // Rename the columns in combinedTable using the mapping
    // Rename columns based on property set definitions
    namedProps = Table.RenameColumns(combinedTable, renames, MissingField.Ignore),
    normalize = List.RemoveNulls(
        List.Transform(
            Table.ColumnNames(namedProps),
            each {_, NormalizeName(_)}
        )
    ),
    
    // Apply the renames to ensure unique column names
    finalRename = Table.RenameColumns(namedProps, normalize),
    
    // Select only relevant columns, keeping the Link column for joining with model data
    relevantColumns = 
        List.RemoveItems(
            Table.ColumnNames(finalRename),
            {"Libid", "Defid", "Createdat", "Createdby", "Modifiedat", "Modifiedby", "V", "Schemav", "_Actions"}
        )
    
in
    {finalRename, relevantColumns} // Return the final table, relevant columns, and entitiesList for debugging
 
in
    [
        GetTrimbleData = GetTrimbleData,
        GetPSetLibDefs = GetPSetLibDefs,
        GetTrimblePsets = GetTrimblePsets
    ]