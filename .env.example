# ModelBridge — Environment Variables
# Copy this to .env and fill in your values.

# Server
PORT=3000

# Admin usernames (comma-separated) — these users can configure ModelBridge
ADMIN_USERNAMES=

# Produuzit API base URL
PRODUUZIT_BASE_URL=https://back.produuz.it/api/v2

# Service account token — OPTION A (preferred): paste long-lived refresh token here
# Get it once via OPTION B below, then hard-code it here so startup is instant.
PRODUUZIT_REFRESH_TOKEN=

# Service account token — OPTION B: admin bootstrap
# If PRODUUZIT_REFRESH_TOKEN is empty, the app will log in as admin on first API call,
# list company API accounts, call get_token on the chosen account, and print the
# refresh token to the console. Paste that into PRODUUZIT_REFRESH_TOKEN above.
PRODUUZIT_ADMIN_USERNAME=
PRODUUZIT_ADMIN_PASSWORD=
PRODUUZIT_API_ACCOUNT_ID=   # optional — ID of the API account to use; omit to use first

# Trimble Connect OAuth
TRIMBLE_CLIENT_ID=
TRIMBLE_CLIENT_SECRET=
TRIMBLE_SCOPE=openid Datatable_extractor
TRIMBLE_AUTHORIZE_URI=https://id.trimble.com/oauth/authorize
TRIMBLE_TOKEN_URI=https://id.trimble.com/oauth/token

# Trimble callback URLs (comma-separated — register all at Trimble)
TRIMBLE_CALLBACK_URLS=https://produuzit.blitta.nl/api/trimble/auth/callback,http://localhost/api/trimble/auth/callback

# Reporting scheduler — replaces the ProduuzitAPI Power Automate solution.
# Uses a SEPARATE Produuzit API account (not PRODUUZIT_REFRESH_TOKEN above).
REPORTING_ENABLED=false
REPORTING_REFRESH_TOKEN=
# REPORTING_TIME=18:15
# REPORTING_TIMEZONE=Europe/Amsterdam
# REPORTING_PAGE_SIZE=1000
# REPORTING_MAX_PAGES=60
