# ModelBridge — Environment Variables
# Copy this to .env and fill in your values.

# Server
PORT=3000

# Logging: error | warn | info | debug | trace (default: info)
#   debug  every incoming route and every outgoing API call (method, url, status, ms)
#   trace  debug plus the bodies of those API calls (truncated, credentials redacted)
# The effective level is printed as the first line at startup.
LOG_LEVEL=info
# Optional — when set, all log lines are also appended to this file
# LOG_FILE=data/modelbridge.log

# SQLite state file. Relative paths resolve against the folder the app is
# started from, so a service started elsewhere would silently get a new, empty
# database; use an absolute path when running as a service. A missing file (or
# missing tables) is created on startup; every setting then falls back to the
# values in this file until changed on the admin page.
# DB_PATH=state.db

# Admin usernames (comma-separated) — these users can configure ModelBridge.
# Everyone who can log in with a Produuzit account can use the app; only the
# names listed here can reach the admin page. Leave empty and nobody can.
ADMIN_USERNAMES=

# Session cookies get the Secure flag automatically when the request arrived
# over HTTPS (detected via X-Forwarded-Proto, which IIS sets). Set this to true
# only if that header is stripped by your proxy.
# COOKIE_SECURE=false

# Maximum size, in megabytes, of an uploaded CSV or cloud-storage file.
# MAX_UPLOAD_MB=25

# Produuzit API base URL
PRODUUZIT_BASE_URL=https://back.produuz.it/api/v2

# Service account token — OPTION A (preferred): paste long-lived refresh token here
# Get it once via OPTION B below, then hard-code it here so startup is instant.
PRODUUZIT_REFRESH_TOKEN=

# Service account token — OPTION B: admin bootstrap
# If PRODUUZIT_REFRESH_TOKEN is empty, the app will log in as admin on first API call,
# list company API accounts, call get_token on the chosen account, and print the
# refresh token to the console. Paste that into PRODUUZIT_REFRESH_TOKEN above.
PRODUUZIT_ADMIN_USERNAME=
PRODUUZIT_ADMIN_PASSWORD=
# Optional — ID of the API account to use; omit to use the first one
PRODUUZIT_API_ACCOUNT_ID=

# Trimble Connect OAuth
TRIMBLE_CLIENT_ID=
TRIMBLE_CLIENT_SECRET=
TRIMBLE_SCOPE=openid Datatable_extractor
TRIMBLE_AUTHORIZE_URI=https://id.trimble.com/oauth/authorize
TRIMBLE_TOKEN_URI=https://id.trimble.com/oauth/token

# Trimble callback URLs (comma-separated — register all at Trimble)
TRIMBLE_CALLBACK_URLS=https://produuzit.blitta.nl/api/trimble/auth/callback,http://localhost/api/trimble/auth/callback

# Default server-side entity filter for the Trimble import. 'CalculatedGeometryValues'
# keeps only entities that carry geometry. Empty = no filter. The import screen
# can override it per run.
# TRIMBLE_ENTITY_TEXT_FILTER=

# Reporting scheduler — replaces the ProduuzitAPI Power Automate solution.
# Uses a SEPARATE Produuzit API account (not PRODUUZIT_REFRESH_TOKEN above).
REPORTING_ENABLED=false
REPORTING_REFRESH_TOKEN=
# REPORTING_TIME=18:15
# REPORTING_TIMEZONE=Europe/Amsterdam
# REPORTING_PAGE_SIZE=1000
# REPORTING_MAX_PAGES=60
# Defaults to PRODUUZIT_BASE_URL
# REPORTING_BASE_URL=
# One-time seed for the report schedule (SharePoint list export). Read only
# while the schedule table is empty, i.e. on a fresh database.
# REPORTING_CONFIG_CSV=data/produuzit_api_frequentie.csv
# REPORTING_OUTPUT_DIR=data/reporting
# REPORTING_LAST_RUN_FILE=data/reporting_last_run.json

# SharePoint (reporting output) — set the first four to write snapshots to
# SharePoint instead of the local output dir. The Azure AD app needs
# Sites.ReadWrite.All.
# SHAREPOINT_SITE_URL=https://blittanl.sharepoint.com/sites/Produuzit-APIdata
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_BASE_FOLDER=Shared Documents/API data
